{
	"luci-app-autheap-client": {
		"description": "Grant access to AuthEAP-Client LuCI app",
		"read": {
			"ubus": {
				"luci.autheap_client": [ "get_config", "list_interfaces", "list_plugins", "status", "log", "log_files", "config_file", "nettest" ],
				"service": [ "list" ],
				"file": [ "read" ]
			},
			"uci": [ "autheap-client" ]
		},
		"write": {
			"ubus": {
				"luci.autheap_client": [ "set_config", "control", "log_clear", "gen_config" ],
				"service": [ "set", "call" ],
				"file": [ "write" ]
			},
			"uci": [ "autheap-client" ]
		}
	}
}
