#!/bin/sh /etc/rc.common
# OpenWrt 启动脚本：AuthEAP-Client (Rust)
#
# 语义说明：
#   - “开机自启”由本脚本的 enable/disable（生成/移除 /etc/rc.d 软链）控制，
#     安装后默认不随系统启动；LuCI 的“开机自启”开关会调用 enable/disable。
#   - start/stop/restart 随时可手动执行，不被 UCI enabled 拦截。
#   - UCI 的 option enabled 只是 /etc/rc.d 软链状态的镜像；enable/disable
#     （无论来自 LuCI/rpcd 还是手工执行）都会把它写回 UCI，保证界面同步。
#   - **配置文件**：启动前先把 UCI 配置渲染成 /etc/autheap-client.conf，
#     再以 `autheap --config 该文件` 启动 —— 即“LuCI 的配置做成配置文件，后端据此认证”。
#   - **日志**：不再在启动时清空（保留历史），由后端按大小自动轮转清理
#     （log_max_kb / log_keep / log_rotate_secs，可在 LuCI 调整）。

START=95
STOP=10

USE_PROCD=1

PROG=/usr/bin/autheap
PIDFILE=/var/run/autheap-client.pid
LOGFILE=/var/log/autheap-client.log
CONF_FILE=/etc/autheap-client.conf
GENCONF=/usr/libexec/autheap-client/gen-config
MLINE_SETUP=/usr/libexec/autheap-client/mline-setup

# ---------------------------------------------------------------------------
# enable / disable：开机自启 = /etc/rc.d 下的 S/K 软链。
# 这里在 rc.common 默认行为之外，把结果同步写回 UCI 的 enabled 选项，
# 这样无论是 LuCI、rpcd 还是手工执行 `/etc/init.d/autheap-client enable`
# 来切换开机自启，LuCI 配置页和状态页看到的都是同一个状态。
# ---------------------------------------------------------------------------
enable() {
	local name="$(basename "$initscript")" rc=0
	[ -n "$START" ] && { ln -sf "../init.d/$name" "$IPKG_INSTROOT/etc/rc.d/S${START}${name##S[0-9][0-9]}" || rc=1; }
	[ -n "$STOP" ] && { ln -sf "../init.d/$name" "$IPKG_INSTROOT/etc/rc.d/K${STOP}${name##K[0-9][0-9]}" || rc=1; }
	uci -q set "autheap-client.main.enabled=1" && uci -q commit autheap-client
	return $rc
}

disable() {
	local name="$(basename "$initscript")" rc=0
	rm -f "$IPKG_INSTROOT"/etc/rc.d/S??$name || rc=1
	rm -f "$IPKG_INSTROOT"/etc/rc.d/K??$name || rc=1
	uci -q set "autheap-client.main.enabled=0" && uci -q commit autheap-client
	return $rc
}

# 开机启动入口：只有 rc.common 的 boot 动作会设置 AUTHEAP_BOOT_START=1，
# 手动 `/etc/init.d/autheap-client start` 和 LuCI 的“启动”按钮不会设置，
# 因此后端能区分“开机等 10 分钟再认证”和“用户点启动立即认证”。
boot() {
	AUTHEAP_BOOT_START=1
	export AUTHEAP_BOOT_START
	start "$@"
}

line_log_file() {
	local section="$1" lf='' base=''
	config_get lf "$section" log_file ''
	if [ -n "$lf" ]; then
		printf '%s' "$lf"
		return
	fi
	config_get base main log_file "$LOGFILE"
	[ -n "$base" ] || base="$LOGFILE"
	case "$base" in
		*.log) printf '%s' "${base%.log}.$section.log" ;;
		*)     printf '%s' "$base.$section" ;;
	esac
}

# 启动一个认证实例：单线模式 name=main；多线模式 name=线路 section 名。
start_one() {
	local name="$1" conf="$2" user="$3" pass="$4" log="$5" pid="$6"
	mkdir -p "$(dirname "$log")" 2>/dev/null || true
	[ -f "$log" ] || : > "$log" 2>/dev/null || true
	echo "[init] $(date '+%Y-%m-%d %H:%M:%S') 实例=$name 用户=$user 密码长度=${#pass} 配置=$conf" >> "$log" 2>/dev/null

	if [ "$MLINE_DAEMON" = "1" ]; then
		/bin/sh -c "exec $PROG --daemon --config \"$conf\" >/dev/null 2>>\"$log\"" &
		return 0
	fi

	procd_open_instance "$name"
	procd_set_param env "AUTHEAP_PASSWORD=$pass" "AUTHEAP_BOOT_START=$AUTHEAP_BOOT_START"
	procd_set_param command /bin/sh -c "exec >/dev/null 2>>\"$log\"; exec $PROG --config \"$conf\""
	procd_set_param pidfile "$pid"
	procd_close_instance
}

start_mline_line() {
	local section="$1" enabled ifname user pass conf log pid
	config_get_bool enabled "$section" enabled 1
	[ "$enabled" = "1" ] || return 0
	config_get ifname "$section" ifname ''
	[ -n "$ifname" ] || {
		echo "[mline] 线路 $section 未设置 ifname" >&2
		MLINE_FAILED=1
		return 0
	}
	config_get user "$section" username "$MAIN_USERNAME"
	config_get pass "$section" password "$MAIN_PASSWORD"
	[ -n "$user" ] || user="$MAIN_USERNAME"
	[ -n "$pass" ] || pass="$MAIN_PASSWORD"
	conf="/etc/autheap-client.$section.conf"
	if ! "$GENCONF" "$conf" "$section" >/dev/null 2>&1; then
		echo "[mline] 线路 $section 生成配置失败" >&2
		echo "[mline] $( "$GENCONF" "$conf" "$section" 2>&1 )" >&2
		MLINE_FAILED=1
		return 0
	fi
	log="$(line_log_file "$section")"
	config_get pid "$section" pid_file "/var/run/autheap-client.$section.pid"
	[ -n "$pid" ] || pid="/var/run/autheap-client.$section.pid"
	MLINE_COUNT=$((MLINE_COUNT + 1))
	start_one "$section" "$conf" "$user" "$pass" "$log" "$pid" || MLINE_FAILED=1
}

start_service() {
	config_load autheap-client

	AUTHEAP_BOOT_START="${AUTHEAP_BOOT_START:-0}"
	export AUTHEAP_BOOT_START

	local username password
	config_get username main username ""
	config_get password main password ""
	config_get_bool daemon main daemon 0
	config_get_bool mline main mline 0
	MLINE_DAEMON="$daemon"

	if [ "$mline" != "1" ]; then
		if [ -z "$username" ]; then
			echo "启动失败：UCI 未设置用户名（autheap-client.main.username）"
			logger -t autheap-client "username not set; refusing to start"
			return 1
		fi
		if [ -z "$password" ]; then
			echo "启动失败：UCI 未设置密码（autheap-client.main.password）"
			logger -t autheap-client "password not set; refusing to start"
			return 1
		fi
	fi

	[ -x "$PROG" ] || {
		echo "启动失败：找不到可执行文件 $PROG（主程序包 AuthEAP-Client 是否已安装？）"
		logger -t autheap-client "binary $PROG missing"
		return 1
	}
	[ -x "$GENCONF" ] || {
		echo "启动失败：缺少配置渲染脚本 $GENCONF（luci-app-autheap-client 是否已安装？）"
		logger -t autheap-client "missing $GENCONF（配置渲染脚本）"
		return 1
	}

	# 日志目录/文件：保留历史，不清空（避免“看不到历史记录”）
	mkdir -p "$(dirname "$LOGFILE")" 2>/dev/null || true
	[ -f "$LOGFILE" ] || : > "$LOGFILE" 2>/dev/null || true

	# ---------- 多线多拨 ----------
	if [ "$mline" = "1" ]; then
		[ -x "$MLINE_SETUP" ] || {
			echo "启动失败：缺少多线辅助脚本 $MLINE_SETUP"
			return 1
		}
		if ! "$MLINE_SETUP" setup; then
			echo "启动失败：创建多线 macvlan 接口失败"
			logger -t autheap-client "mline setup failed"
			"$MLINE_SETUP" cleanup 2>/dev/null || true
			return 1
		fi
		# 仍生成一份 main 配置，供配置页查看/排错；认证实际用各线路配置。
		"$GENCONF" "$CONF_FILE" >/dev/null 2>&1 || true
		MLINE_COUNT=0
		MLINE_FAILED=0
		MAIN_USERNAME="$username"
		MAIN_PASSWORD="$password"
		config_foreach start_mline_line line
		if [ "$MLINE_COUNT" = "0" ]; then
			echo "启动失败：mline 已启用但没有启用的线路"
			logger -t autheap-client "mline enabled but no line"
			return 1
		fi
		[ "$MLINE_FAILED" = "0" ] || {
			echo "启动完成，但有线路启动失败；请查看 /var/log/autheap-client.<line>.log"
			logger -t autheap-client "mline partial start failure"
			return 1
		}
		return 0
	fi

	# ---------- 单线模式 ----------
	if ! "$GENCONF" "$CONF_FILE" >/dev/null 2>&1; then
		echo "启动失败：gen-config 生成 $CONF_FILE 出错"
		logger -t autheap-client "gen-config failed"
		return 1
	fi
	[ -s "$CONF_FILE" ] || {
		echo "启动失败：$CONF_FILE 为空"
		logger -t autheap-client "empty $CONF_FILE"
		return 1
	}
	start_one main "$CONF_FILE" "$username" "$password" "$LOGFILE" "$PIDFILE"
}

stop_service() {
	# 不要在这里直接杀进程！rc.common 的 stop() 是
	#   stop_service    ← 先跑这个
	#   procd_kill     ← 再通知 procd 停（托管的进程由 procd 收尾）
	# 若在这里就 killall，procd 会看到“进程自己死了”，容易造成状态不一致。
	# 所以：只有守护模式（daemon=1，不经 procd）才在这里按名字结束；
	# 其余托管实例交给 procd，收尾/兼底放在 service_stopped() 里。
	config_load autheap-client
	local daemon
	config_get_bool daemon main daemon 0
	if [ "$daemon" = 1 ]; then
		killall autheap 2>/dev/null
		local i=0
		while [ "$i" -lt 15 ]; do
			pidof autheap >/dev/null 2>&1 || break
			sleep 0.2 2>/dev/null || sleep 1
			i=$((i + 1))
		done
		pidof autheap >/dev/null 2>&1 && killall -9 autheap 2>/dev/null
	fi
	rm -f "$PIDFILE"
	return 0
}

# rc.common 的 stop() 在 procd_kill 之后会调用它（如果定义了）
service_stopped() {
	local was_running=0 i=0
	pidof autheap >/dev/null 2>&1 && was_running=1
	while [ "$i" -lt 15 ]; do
		pidof autheap >/dev/null 2>&1 || break
		sleep 0.2 2>/dev/null || sleep 1
		i=$((i + 1))
	done
	if pidof autheap >/dev/null 2>&1; then
		killall -9 autheap 2>/dev/null
		sleep 0.3 2>/dev/null || true
		if pidof autheap >/dev/null 2>&1; then
			echo "停止失败：autheap 进程仍在运行（pid: $(pidof autheap)）"
			return 1
		fi
		echo "已强制结束 autheap 进程（SIGTERM 无响应，已发 SIGKILL）"
	elif [ "$was_running" = 1 ]; then
		echo "已停止 autheap 进程"
	else
		echo "服务当前未运行（无需停止）"
	fi
	# 多线模式：进程停止后再删除本脚本创建的 macvlan，避免拆掉仍在认证的接口。
	# 无论当前是否仍启用 mline，都清理一次状态目录；切换配置后停止服务
	# 也能把上一次创建的 macvlan 收干净（脚本只删自己记录过的接口）。
	if [ -x "$MLINE_SETUP" ]; then
		"$MLINE_SETUP" cleanup 2>&1 || true
	fi
	return 0
}
