#!/bin/sh /etc/rc.common
# OpenWrt 启动脚本：AuthEAP-Client (Rust)
#
# 语义说明：
#   - “开机自启”由本脚本的 enable/disable（生成/移除 /etc/rc.d 软链）控制，
#     安装后默认不随系统启动；LuCI 的“开机自启”开关会调用 enable/disable。
#   - start/stop/restart 随时可手动执行，不被 UCI enabled 拦截。
#   - UCI 的 option enabled 仅作 LuCI 显示/同步的指示位（保留兼容）。
#   - **配置文件**：启动前先把 UCI 配置渲染成 /etc/autheap-client.conf，
#     再以 `autheap --config 该文件` 启动 —— 即“LuCI 的配置做成配置文件，后端据此认证”。
#   - **日志**：不再在启动时清空（保留历史），由后端按大小自动轮转清理
#     （log_max_kb / log_keep / log_rotate_secs，可在 LuCI 调整）。

START=95
STOP=10

USE_PROCD=1

PROG=/usr/bin/autheap
PIDFILE=/var/run/autheap-client.pid
LOGFILE=/var/log/autheap-client.log
CONF_FILE=/etc/autheap-client.conf
GENCONF=/usr/libexec/autheap-client/gen-config

start_service() {
	config_load autheap-client

	local username password
	config_get username main username ""
	config_get password main password ""
	config_get_bool daemon main daemon 0

	if [ -z "$username" ]; then
		echo "启动失败：UCI 未设置用户名（autheap-client.main.username）"
		logger -t autheap-client "username not set; refusing to start"
		return 1
	fi
	if [ -z "$password" ]; then
		echo "启动失败：UCI 未设置密码（autheap-client.main.password）"
		logger -t autheap-client "password not set; refusing to start"
		return 1
	fi

	[ -x "$PROG" ] || {
		echo "启动失败：找不到可执行文件 $PROG（主程序包 AuthEAP-Client 是否已安装？）"
		logger -t autheap-client "binary $PROG missing"
		return 1
	}
	[ -x "$GENCONF" ] || {
		echo "启动失败：缺少配置渲染脚本 $GENCONF（luci-app-autheap-client 是否已安装？）"
		logger -t autheap-client "missing $GENCONF（配置渲染脚本）"
		return 1
	}

	# 日志目录/文件：保留历史，不清空（避免“看不到历史记录”）
	mkdir -p "$(dirname "$LOGFILE")" 2>/dev/null || true
	[ -f "$LOGFILE" ] || : > "$LOGFILE" 2>/dev/null || true

	# 1) UCI → 配置文件（后端认证实际读取的就是它）
	if ! "$GENCONF" "$CONF_FILE" >/dev/null 2>&1; then
		echo "启动失败：gen-config 生成 $CONF_FILE 出错"
		logger -t autheap-client "gen-config failed"
		return 1
	fi
	[ -s "$CONF_FILE" ] || {
		echo "启动失败：$CONF_FILE 为空"
		logger -t autheap-client "empty $CONF_FILE"
		return 1
	}

	# 记录本次启动（密码只记长度），便于与 CLI 对照排查
	echo "[init] $(date '+%Y-%m-%d %H:%M:%S') 用户=$username 密码长度=${#password} 插件配置见 $CONF_FILE" >> "$LOGFILE" 2>/dev/null

	# 2) 启动后端：只传 --config，其余参数全部来自配置文件
	if [ "$daemon" = "1" ]; then
		# 守护模式：不交给 procd 托管（停止用 killall）；日志由后端自己写文件
		/bin/sh -c "exec $PROG --daemon --config \"$CONF_FILE\" >/dev/null 2>>\"$LOGFILE\"" &
		return 0
	fi

	procd_open_instance
	procd_set_param env AUTHEAP_PASSWORD "$password"
	# stdout 丢弃、stderr（崩溃/启动错误）追加到日志；正常日志由后端写入配置里的 log_file
	procd_set_param command /bin/sh -c "exec >/dev/null 2>>\"$LOGFILE\"; exec $PROG --config \"$CONF_FILE\""
	procd_set_param pidfile "$PIDFILE"
	# 不设置 respawn：客户端自身有重试逻辑，避免失败时 procd 疯狂重启刷屏
	procd_close_instance
}

stop_service() {
	# 不要在这里直接杀进程！rc.common 的 stop() 是
	#   stop_service    ← 先跑这个
	#   procd_kill     ← 再通知 procd 停（托管的进程由 procd 收尾）
	# 若在这里就 killall，procd 会看到“进程自己死了”，容易造成状态不一致。
	# 所以：只有守护模式（daemon=1，不经 procd）才在这里按名字结束；
	# 其余托管实例交给 procd，收尾/兼底放在 service_stopped() 里。
	config_load autheap-client
	local daemon
	config_get_bool daemon main daemon 0
	if [ "$daemon" = 1 ]; then
		killall autheap 2>/dev/null
		local i=0
		while [ "$i" -lt 15 ]; do
			pidof autheap >/dev/null 2>&1 || break
			sleep 0.2 2>/dev/null || sleep 1
			i=$((i + 1))
		done
		pidof autheap >/dev/null 2>&1 && killall -9 autheap 2>/dev/null
	fi
	rm -f "$PIDFILE"
	return 0
}

# rc.common 的 stop() 在 procd_kill 之后会调用它（如果定义了）
service_stopped() {
	local was_running=0 i=0
	pidof autheap >/dev/null 2>&1 && was_running=1
	while [ "$i" -lt 15 ]; do
		pidof autheap >/dev/null 2>&1 || break
		sleep 0.2 2>/dev/null || sleep 1
		i=$((i + 1))
	done
	if pidof autheap >/dev/null 2>&1; then
		killall -9 autheap 2>/dev/null
		sleep 0.3 2>/dev/null || true
		if pidof autheap >/dev/null 2>&1; then
			echo "停止失败：autheap 进程仍在运行（pid: $(pidof autheap)）"
			return 1
		fi
		echo "已强制结束 autheap 进程（SIGTERM 无响应，已发 SIGKILL）"
	elif [ "$was_running" = 1 ]; then
		echo "已停止 autheap 进程"
	else
		echo "服务当前未运行（无需停止）"
	fi
	return 0
}
