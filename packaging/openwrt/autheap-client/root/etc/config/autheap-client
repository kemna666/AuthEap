config autheap-client 'main'
	option enabled '0'
	option ifname 'eth0'
	option username ''
	option password ''
	option backend 'raw'
	list plugins 'rjv3'          # 启用的插件（可多个；需已编译进客户端）
	option heartbeat '20'
	option eap_bcast_addr '0'
	option dhcp_type '2'
	option dhcp_script ''
	option service 'internet'
	option version_str 'RG-SU For Linux V1.0'
	option fake_dns1 ''
	option fake_dns2 ''
	option fake_serial ''
	option max_dhcp_count '3'
	option max_retries '3'
	option max_failures '3'
	option stage_timeout '5'
